12.
select 
e1.employee_id, count(e1.employee_id) as team_size
from employee as e1
join employee as e2
 on e.team_id=e2.team_id
group by e1.employee_id
order by asc

13. 
select project_id, Round (Avg(p.experience_years),2) as average_years
from project as p
join employee as e
on p.emp_id=e.emp_id
group by p.project
order by p.project asc

14. select w.name as warehouse_name, Sum(w.units*p.w*p.l*p.h) as volume
from warehouse as w
join product as p
on w.pro_id=p.pro_id
groub by w.name ;

15.
select p.firstname,p.lastname,a.city,a.state
from address as a
right join person as p
on a.personid=p.personid
order by p.firstName asc, p.lastname asc;

16.
select name as customers
from customer as c
left join orders as o
on c.customer_id=o.customer_id
where c.customer_id is null

17.
select s.student_id s.name
from student as s
right join department as d
on d.dep_id=s.dep_id
where d.dep_id is null

18. 
select e.name, b.bonus
from bonus as b
right join employee as e
on e.emp_id=b.emp_id
where b.bonus<1000 or b.bonus is null


19. 
select v.customer_id, count(*) as count_no_trance
from visist as v
leftjoin transaction as t
on v.visit_id=t.visit_id
where t.visit_id is null
groupby v.customer_id
order by count-no_trance desc

